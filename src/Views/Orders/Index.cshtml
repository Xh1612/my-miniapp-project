@model List<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<section class="khu-noi-dung">
    <h1>Đơn hàng của tôi</h1>
    @foreach (var o in Model)
    {
        <div style="padding:0.5rem 0; border-bottom:1px solid var(--giay-do-toi);">
            <a asp-action="Confirmation" asp-route-id="@o.Id">Đơn #@o.Id</a> — @o.Status — @o.TotalAmount.ToString("N0") đ
        </div>
    }
</section>
