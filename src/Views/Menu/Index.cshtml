@model List<Product>
@{ ViewData["Title"] = "Thực đơn"; }

<section class="khu-noi-dung">
    <h1>Thực đơn</h1>
    <form method="get" style="margin-bottom:1.5rem; display:flex; gap:0.6rem;">
        <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm món ăn..." style="flex:1; padding:0.6rem; border-radius:8px; border:1px solid var(--giay-do-toi);" />
        <button type="submit" class="btn-dau">Tìm</button>
        <a asp-action="AdvancedSearch" style="align-self:center; color:var(--la-tre); white-space:nowrap;">Tìm nâng cao →</a>
    </form>
    <div style="margin-bottom:1.5rem; display:flex; gap:0.6rem; flex-wrap:wrap;">
        <a asp-action="Index" class="badge-cay">Tất cả</a>
        @foreach (var c in (List<Category>)ViewBag.Categories)
        {
            <a asp-action="Index" asp-route-categoryId="@c.Id" class="badge-cay">@c.Name</a>
        }
    </div>
    <div class="luoi-mon">
        @foreach (var p in Model) { <partial name="_ProductCard" model="p" /> }
    </div>
</section>
