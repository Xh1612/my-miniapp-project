@model Address
@{ ViewData["Title"] = "Thêm địa chỉ"; }

<section class="khu-noi-dung" style="max-width:500px;">
    <h1>Thêm địa chỉ giao hàng</h1>
    <form method="post">
        <input name="Province" placeholder="Tỉnh/Thành phố" required style="width:100%; padding:0.6rem; margin-bottom:0.6rem;" /><br />
        <input name="District" placeholder="Quận/Huyện" required style="width:100%; padding:0.6rem; margin-bottom:0.6rem;" /><br />
        <input name="Ward" placeholder="Phường/Xã" required style="width:100%; padding:0.6rem; margin-bottom:0.6rem;" /><br />
        <input name="Street" placeholder="Số nhà, đường" required style="width:100%; padding:0.6rem; margin-bottom:0.6rem;" /><br />
        <input name="Lat" type="number" step="0.000001" placeholder="Vĩ độ (Lat)" required style="width:100%; padding:0.6rem; margin-bottom:0.6rem;" /><br />
        <input name="Lng" type="number" step="0.000001" placeholder="Kinh độ (Lng)" required style="width:100%; padding:0.6rem; margin-bottom:0.6rem;" /><br />
        <button type="submit" class="btn-dau">Lưu địa chỉ</button>
    </form>
</section>
